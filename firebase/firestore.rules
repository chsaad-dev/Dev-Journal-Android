rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /posts/{postId} {
      allow read: if resource.data.published == true
        || (request.auth != null && request.auth.uid == resource.data.authorId);
      
      allow create: if request.auth != null;
      
      allow update: if request.auth != null && (
        isAdmin() || 
        request.auth.uid == resource.data.authorId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount']) && resource.data.published == true)
      );
      
      allow delete: if request.auth != null
        && (isAdmin() || request.auth.uid == resource.data.authorId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && (request.auth.uid == resource.data.userId || isAdmin());
      }
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /likedPosts/{postId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /bookmarks/{postId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
