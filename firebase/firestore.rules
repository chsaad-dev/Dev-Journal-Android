rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'reader') == "admin";
    }

    function isSuspended() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) == true;
    }

    match /posts/{postId} {
      allow read: if resource.data.get('published', false) == true
        || (request.auth != null && request.auth.uid == resource.data.get('authorId', ''))
        || isAdmin();
      allow create: if request.auth != null && !isSuspended()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && !isSuspended()
        && (isAdmin() || request.auth.uid == resource.data.get('authorId', ''));
      allow update: if request.auth != null && !isSuspended()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'likeCount', 'commentCount']);
      allow delete: if request.auth != null && !isSuspended()
        && (isAdmin() || request.auth.uid == resource.data.get('authorId', ''));

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && !isSuspended();
        allow delete: if request.auth != null
          && (request.auth.uid == resource.data.get('userId', '') || isAdmin());
      }

      match /views/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid && !isSuspended();
        allow update, delete: if false;
      }
    }

    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    match /broadcasts/{broadcastId} {
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Allow authenticated non-suspended users to increment/decrement follower & following counts
      allow update: if request.auth != null && !isSuspended()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount', 'followingCount']);

      match /likedPosts/{postId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid && !isSuspended();
      }

      match /bookmarks/{postId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid && !isSuspended();
      }

      // Allow users to record themselves in target's followers list
      match /followers/{followerId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == followerId && !isSuspended();
      }

      // Allow users to manage who they are following
      match /following/{followingId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == uid && !isSuspended();
      }
    }
  }
}
