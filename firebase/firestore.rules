rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if resource.data.published == true
        || (request.auth != null && request.auth.uid == resource.data.authorId);
      allow create: if request.auth != null && request.auth.token.role == "admin";
      allow update, delete: if request.auth != null
        && (request.auth.token.role == "admin" || request.auth.uid == resource.data.authorId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && (request.auth.uid == resource.data.userId || request.auth.token.role == "admin");
      }
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /likedPosts/{postId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
